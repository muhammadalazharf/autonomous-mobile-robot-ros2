<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_startup</name>
  <version>0.1.0</version>
  <description>Master launch files — single entry point to start the AMR</description>
  <maintainer email="malazharfaradis@gmail.com">Muhammad Al Azhar Faradis</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>

  <exec_depend>amr_body</exec_depend>
  <exec_depend>amr_sensors</exec_depend>
  <exec_depend>amr_motor</exec_depend>
  <exec_depend>amr_pose</exec_depend>
  <exec_depend>amr_mapping</exec_depend>
  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>amr_brain</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
